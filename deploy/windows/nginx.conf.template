# AutomationEdge HR - Nginx for Windows
# Generated by deploy\windows\setup.ps1 ({{APP_ROOT}} is filled in automatically).
#   Port 8099 : public entry point (this file)
#   Port 8081 : Python backend, bound to 127.0.0.1 only (not reachable from other machines)

worker_processes  1;

events {
    worker_connections  1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    keepalive_timeout  65;
    client_max_body_size  25m;   # resume / document uploads

    gzip  on;
    gzip_types  text/css application/javascript application/json image/svg+xml;

    upstream hr_backend {
        server 127.0.0.1:8081;
    }

    server {
        listen       8099;
        server_name  _;

        # Built React app (frontend\dist)
        root   "{{APP_ROOT}}/frontend/dist";
        index  index.html;

        # API -> Python backend. Approvals call ServiceNow, T4, O365 and OrangeHRM in sequence,
        # so allow long responses.
        location /api/ {
            proxy_pass          http://hr_backend;
            proxy_http_version  1.1;
            proxy_set_header    Host               $host;
            proxy_set_header    X-Real-IP          $remote_addr;
            proxy_set_header    X-Forwarded-For    $proxy_add_x_forwarded_for;
            proxy_read_timeout  300s;
            proxy_send_timeout  300s;
        }

        # Generated offer-letter PDFs are served by the backend
        location /generated_offers/ {
            proxy_pass  http://hr_backend;
        }

        # Hashed build assets can be cached for a long time
        location /assets/ {
            expires  30d;
            add_header  Cache-Control "public, immutable";
            try_files  $uri =404;
        }

        # React single-page app: unknown paths fall back to index.html
        location / {
            try_files  $uri /index.html;
        }
    }
}
