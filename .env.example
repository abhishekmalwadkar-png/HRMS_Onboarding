# ====================================================================
# HRMS Onboarding Orchestrator - Environment Variables Template
# Copy this file to .env and configure with your actual credentials.
# ====================================================================

# 1. ServiceNow Instance Credentials (PDI / Service Catalog API)
SN_INSTANCE_URL=https://your-instance.service-now.com
SN_USERNAME=your_servicenow_username
SN_PASSWORD=your_servicenow_password
SN_CATALOG_ITEM_SYS_ID=your_catalog_item_sys_id

# 2. AutomationEdge T4 Cloud Server RPA Credentials
AE_SERVER_URL=https://t4.automationedge.com/aeengine
AE_ORG_CODE=YOUR_ORG_CODE
AE_USERNAME=your_ae_username
AE_PASSWORD=your_ae_password
AE_USER_ID=your_ae_user_display_name
AE_SOURCE=AutomationEdge HelpDesk

# 3. Microsoft 365 / Entra ID / Microsoft Graph API Credentials
O365_CLIENT_ID=your_azure_client_id
O365_CLIENT_SECRET=your_azure_client_secret
O365_TENANT_ID=your_azure_tenant_id
O365_DEFAULT_DOMAIN=yourdomain.com
O365_REFRESH_TOKEN=your_oauth2_refresh_token

# 4. OrangeHRM Instance Credentials
ORANGEHRM_BASE_URL=http://your-orangehrm-host/orangehrm
ORANGEHRM_USERNAME=admin
ORANGEHRM_PASSWORD=your_orangehrm_admin_password

# 5. AutomationEdge RPA Workflow Names
AE_WORKFLOW_CREATE_AD_ACCOUNT=AD-Create User and Assin Role
AE_WORKFLOW_RESUME_SCREENING=AE_Resume_Screening
AE_WORKFLOW_INTERVIEW_SCHEDULING=AE_Interview_Scheduling
AE_WORKFLOW_CANDIDATE_COMMUNICATION=AE_Candidate_Communication
AE_WORKFLOW_ITSM_ASSET_ALLOCATION=AE_ITSM_Asset_Allocation
AE_WORKFLOW_ACCESS_PROVISIONING=AE_Role_Based_Access_Provisioning
AE_WORKFLOW_INDUCTION_MANAGEMENT=AE_Schedule_Induction_Management
AE_WORKFLOW_SUBMIT_RESIGNATION=Submit_Resignation
